# Copy this file to ".env" and fill in your values. Never share .env.

# Gmail account that receives LinkedIn / Naukri / Indeed job-alert emails
GMAIL_USER=yourname@gmail.com
# 16-character Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Where the daily report is sent (can be the same Gmail)
REPORT_TO=yourname@gmail.com

# Optional: Claude API key for smart match scoring + tailored cover letters.
# Leave empty to use keyword scoring + template cover letters (free).
ANTHROPIC_API_KEY=

# Optional: SerpApi key for Google Jobs search (free plan: 100 searches/month)
SERPAPI_KEY=

# Optional: Groq API key (free tier) - used when ANTHROPIC_API_KEY is empty
GROQ_API_KEY=
